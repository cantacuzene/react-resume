{
  "name": "react-resume",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite",
    "dev:server": "bun --watch src/server/main.ts",
    "start": "bun src/server/main.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "check:tests": "bun scripts/check-tests.ts",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun run check:gql && bun run check:tests && bun run test",
    "prepare": "lefthook install",
    "codegen": "graphql-codegen --config codegen.config.ts",
    "check:gql": "bun run codegen && git diff --exit-code -- src/server/gql src/client/gql"
  },
  "dependencies": {
    "@fontsource/josefin-sans": "^5.3.0",
    "@graphql-tools/schema": "^10.1.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "date-fns": "^4.4.0",
    "graphql": "^17.0.2",
    "graphql-scalars": "^2.0.0",
    "graphql-yoga": "^5.24.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.2",
    "@graphql-codegen/typed-document-node": "^7.1.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.7",
    "@graphql-codegen/typescript-resolvers": "^6.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-prefer-function-component": "^5.0.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.0",
    "lefthook": "^2.1.14",
    "msw": "^2.15.0",
    "prettier": "^3.9.8",
    "typescript": "~6.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
